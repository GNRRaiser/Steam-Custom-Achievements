{
  "slug": "fallout3",
  "appId": 22370,
  "title": "Fallout 3 - Game of the Year Edition",
  "platform": "Xbox 360",
  "detector": "fallout3",
  "setupHint": "Save once in Fallout 3, or select a .fos file in Settings.",
  "pathPlaceholder": "Path to Documents\\My Games\\Fallout3\\Saves (or a .fos file)",
  "trackingNote": "Fallout 3 lost its Games for Windows Live achievements in the 2021 Steam update and never got Steam ones, so these are the Xbox 360 list (base game and the five DLCs). The plugin reads your newest save in Documents\\My Games\\Fallout3\\Saves: finished quests, the Pip-Boy statistics (people and creatures killed, locks, terminals, speech, locations, bobbleheads) and your level and karma. A save only holds your karma now, so a level achievement unlocks for the karma you have when the save is read. Weaponsmith, The Bigger They Are..., Mill Worker, Bog Walker and Alien Archivist are marked by hand for now.",
  "autoTag": "Unlocks automatically from your newest Fallout 3 save",
  "saveFolders": [
    [
      "USERPROFILE",
      "Documents",
      "My Games",
      "Fallout3",
      "Saves"
    ],
    [
      "USERPROFILE",
      "OneDrive",
      "Documents",
      "My Games",
      "Fallout3",
      "Saves"
    ]
  ],
